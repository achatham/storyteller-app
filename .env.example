# Copy to .env and fill in your values.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Docker host binding. Default loopback keeps the unauthenticated backend behind
# your TLS/auth reverse proxy; set 0.0.0.0 only for an intentional LAN deployment.
STORY_BIND=127.0.0.1

# Port the web app listens on
STORY_PORT=8200

# Max concurrent image generations
STORY_GEN_CONCURRENCY=3

# Upload/cost safety limits
STORY_MAX_BOOK_BYTES=52428800
STORY_MAX_UPLOADS_PER_MINUTE=6
# Optional hard USD ceiling per book. Leave blank to disable. A call that would
# exceed it is blocked before its usage is written; set this deliberately.
STORY_BOOK_BUDGET_USD=
